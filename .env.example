# Copia este archivo como .env (no se sube a git) y cambia los valores.

# PostgreSQL: propietario del esquema (migraciones) y rol de la aplicación
DB_OWNER_PASSWORD=cambia-esta-clave-de-propietario
DB_APP_PASSWORD=cambia-esta-clave-de-aplicacion

# Firma de los tokens JWT: al menos 32 caracteres aleatorios
# (por ejemplo: openssl rand -base64 48)
JWT_SECRET=

# Propietario inicial: se crea solo si la base de datos no tiene usuarios
OWNER_EMAIL=
OWNER_NAME=Jaime Gallo
OWNER_PASSWORD=
